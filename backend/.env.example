# ==============================================================================
# PassMan Backend - Environment Variables
# ==============================================================================

# Supabase PostgreSQL Connection String (Transaction Pooler or Direct)
# Note: FastAPI uses asyncpg, so the scheme must be postgresql+asyncpg://
# Example: postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# JWT Security Configuration
JWT_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ALGORITHM=HS256

# Android Platform Token & Vault Lock Configuration
ANDROID_ACCESS_TOKEN_EXPIRES=10 # in minutes (10 mins)
ANDROID_REFRESH_TOKEN_EXPIRES=10 # in days (10 days)
ANDROID_VAULT_LOCK=15 # in minutes (user selectable: 5-30 mins, default: 15 mins)

# Web Platform Token & Vault Lock Configuration
WEB_ACCESS_TOKEN_EXPIRES=10 # in minutes (10 mins)
WEB_REFRESH_TOKEN_EXPIRES=8 # in hours (8 hrs)
WEB_VAULT_LOCK=15 # in minutes (user selectable: 5-30 mins, default: 15 mins)

# CORS Allowed Origins (Comma-separated list for Flutter Web and local testing)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=info
